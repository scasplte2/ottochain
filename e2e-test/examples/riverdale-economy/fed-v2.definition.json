{
  "states": {
    "stable": { "id": "stable", "isFinal": false },
    "emergency_lending": { "id": "emergency_lending", "isFinal": false }
  },
  "initialState": "stable",
  "transitions": [
    {
      "from": "stable",
      "to": "stable",
      "eventName": "set_rate",
      "guard": { "==": [1, 1] },
      "effect": {
        "_triggers": [
          {
            "targetMachineId": { "var": "event.bankId" },
            "eventName": "rate_adjustment",
            "payload": {
              "newBaseRate": { "var": "event.newBaseRate" }
            }
          }
        ],
        "status": "stable",
        "baseRate": { "var": "event.newBaseRate" },
        "rateChangeCount": { "+": [{ "var": "state.rateChangeCount" }, 1] }
      },
      "dependencies": []
    },
    {
      "from": "stable",
      "to": "emergency_lending",
      "eventName": "emergency_lending",
      "guard": { "==": [1, 1] },
      "effect": {
        "status": "emergency_lending",
        "emergencyLoans": { "+": [{ "var": "state.emergencyLoans" }, 1] }
      },
      "dependencies": []
    }
  ]
}
