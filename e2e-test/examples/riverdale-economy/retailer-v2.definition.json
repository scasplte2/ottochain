{
  "states": {
    "awaiting": { "id": "awaiting", "isFinal": false },
    "received": { "id": "received", "isFinal": false }
  },
  "initialState": "awaiting",
  "transitions": [
    {
      "from": "awaiting",
      "to": "received",
      "eventName": "receive_shipment",
      "guard": { "==": [1, 1] },
      "effect": {
        "status": "received",
        "receivedQuantity": { "var": "event.quantity" },
        "shipmentsReceived": { "+": [{ "var": "state.shipmentsReceived" }, 1] }
      },
      "dependencies": []
    },
    {
      "from": "received",
      "to": "received",
      "eventName": "redeem_loyalty",
      "guard": { ">=": [{ "var": "state.loyaltyPoints" }, 0] },
      "effect": {
        "status": "loyalty_redeemed",
        "loyaltyPoints": { "+": [{ "var": "state.loyaltyPoints" }, { "var": "event.points" }] }
      },
      "dependencies": []
    }
  ]
}
