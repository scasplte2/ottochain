{
  "states": {
    "filling": { "id": "filling", "isFinal": false, "metadata": null },
    "open": { "id": "open", "isFinal": false, "metadata": null },
    "drained": { "id": "drained", "isFinal": true, "metadata": null }
  },
  "initialState": "filling",
  "transitions": [
    {
      "from": "filling",
      "to": "open",
      "eventName": "deposit",
      "guard": {
        "and": [
          { "===": [{ "+": [{ "var": "state.depositCount" }, 1] }, { "var": "state.anonymityTarget" }] },
          { "!!": [{ "var": "event.point" }] },
          { "none": [{ "var": "state.points" }, { "===": [{ "var": "" }, { "var": "event.point" }] }] }
        ]
      },
      "effect": {
        "merge": [
          { "var": "state" },
          {
            "points": { "merge": [{ "var": "state.points" }, [{ "var": "event.point" }]] },
            "depositCount": { "+": [{ "var": "state.depositCount" }, 1] },
            "status": "open"
          }
        ]
      },
      "dependencies": []
    },
    {
      "from": "filling",
      "to": "filling",
      "eventName": "deposit",
      "guard": {
        "and": [
          { "<": [{ "+": [{ "var": "state.depositCount" }, 1] }, { "var": "state.anonymityTarget" }] },
